# OS / editor
.DS_Store
Thumbs.db
*~
.vscode/
.idea/

# Cowork / FUSE sandbox temp files (never commit these)
.fuse_hidden*

# Local env / secrets (config.js holds only the PUBLIC anon key, so it IS tracked)
.env
.env.local

# Node (only if a dev adds tooling later — there is no build step by default)
node_modules/

# Local UI smoke-test harnesses (throwaway; never commit).
# ⚠️ The `_ui_test.html` pattern was too narrow and four harness files shipped to
# production on 2026-09-01 under a different name — a publicly reachable page that
# renders a fake register from fixtures with the auth layer stubbed out. Match the
# WORD, not one filename.
**/_ui_test.html
**/_*_test.html
**/harness.html
**/harness-stub.js
**/*.harness.html

# Supabase CLI local state
supabase/.temp/
__pycache__/
*.pyc
